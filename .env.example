# Endpoint que recibe el formulario (§8).
# Por defecto apunta a la funcion serverless incluida en api/lead.ts.
# Tambien acepta una URL de Formspree o Basin sin tocar codigo.
VITE_FORM_ENDPOINT=/api/lead

# Analitica (§11). Host europeo. Sin clave, la analitica no se carga.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.posthog.com

# Calendario opcional junto al formulario (§6.15). Si esta vacio, no se renderiza.
VITE_CALENDAR_URL=

# Correo de contacto, visible en el mensaje de fallo del formulario. Vacio
# significa que no se pinta ninguno. Las paginas legales publican ya
# hola@ownex.co (aviso legal) y privacidad@ownex.co (RGPD): pon aqui el mismo
# hola@ownex.co en cuanto el buzon exista, para que el sitio no de dos
# direcciones distintas.
VITE_CONTACT_EMAIL=

# TODO(jaime): §12.1. Perfil de LinkedIn del fundador.
VITE_LINKEDIN_URL=

# TODO(jaime): §12.10. Dominio definitivo, usado en canonical y sitemap.
VITE_SITE_URL=https://ownex.co

# --- Solo servidor. Nunca con prefijo VITE_: no deben llegar al navegador. ---

# Mailchimp (§8.5). El lead se da de alta como contacto en esta audiencia, con
# marca y mensaje en los merge fields COMPANY y MMERGE7. El aviso interno y la
# confirmacion al lead se configuran dentro de Mailchimp (Audience > Settings >
# Notifications, y un Automation de bienvenida), no aqui.
MAILCHIMP_API_KEY=
# Sufijo tras el guion de la API key (ej. la key acaba en "-us16" -> us16).
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=
# Webhook opcional para el registro de leads (hoja de calculo o base de Notion).
LEAD_REGISTRY_WEBHOOK=
